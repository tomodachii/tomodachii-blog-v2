@misc{jayasuriyaCausalGuidedDimensionReduction2025,
  title = {Causal-{{Guided Dimension Reduction}} for {{Efficient Pareto Optimization}}},
  author = {Jayasuriya, Dinithi and Kumar, Divake and Senthilkumar, Sureshkumar and Naik, Devashri and Darabi, Nastaran and Trivedi, Amit Ranjan},
  year = 2025,
  month = oct,
  number = {arXiv:2510.09941},
  eprint = {2510.09941},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2510.09941},
  urldate = {2026-03-18},
  abstract = {Multi-objective optimization of analog circuits is hindered by high-dimensional parameter spaces, strong feedback couplings, and expensive transistor-level simulations. Evolutionary algorithms such as Non-dominated Sorting Genetic Algorithm II (NSGA-II) are widely used but treat all parameters equally, thereby wasting effort on variables with little impact on performance, which limits their scalability. We introduce CaDRO, a causal-guided dimensionality reduction framework that embeds causal discovery into the optimization pipeline. CaDRO builds a quantitative causal map through a hybrid observational-interventional process, ranking parameters by their causal effect on the objectives. Low-impact parameters are fixed to values from high-quality solutions, while critical drivers remain active in the search. The reduced design space enables focused evolutionary optimization without modifying the underlying algorithm. Across amplifiers, regulators, and RF circuits, CaDRO converges up to 10\$\textbackslash times\$ faster than NSGA-II while preserving or improving Pareto quality. For instance, on the Folded-Cascode Amplifier, hypervolume improves from 0.56 to 0.94, and on the LDO regulator from 0.65 to 0.81, with large gains in non-dominated solutions.},
  archiveprefix = {arXiv},
  keywords = {causal-discovery,causality,dimension-reduction},
  file = {C:\Users\admin\Zotero\storage\KM82V42T\Jayasuriya et al. - 2025 - Causal-Guided Dimension Reduction for Efficient Pareto Optimization.pdf}
}

