@misc{shethDomainGeneralizationCausal2022,
  title = {Domain {{Generalization}} -- {{A Causal Perspective}}},
  author = {Sheth, Paras and Moraffah, Raha and Candan, K. Sel{\c c}uk and Raglin, Adrienne and Liu, Huan},
  year = 2022,
  month = nov,
  number = {arXiv:2209.15177},
